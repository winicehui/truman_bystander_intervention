extends ui_layout

block styles
  link(type='text/css', rel='stylesheet', href='/public/css/script.css')
  if chatbotEnabled
    link(type='text/css', rel='stylesheet', href='/public/css/chatbot.css')

block content
  #loading.eight.wide.computer.ten.wide.tablet.sixteen.wide.mobile.column
    img.ui.centered.small.image(src='/public/heart.svg')

  #content.twelve.wide.computer.ten.wide.tablet.sixteen.wide.mobile.column.hidden
    each val in script
      if val.relativeTime
        include partials/userPost
      else
        include partials/actorPost

    .ui.fluid.card
      .content
        .description End of Training Post.

    .ui.center.aligned.container(style='margin-top: 2em;')
      button.ui.primary.button#proceed-btn Bring me to the platform
      .ui.hidden.message#error-msg
        if chatbotEnabled
          p You need to interact with the chatbot for more than 5 turns or post a public comment before proceeding.
        else
          p You need to post a public comment before proceeding.

  if chatbotEnabled
    include partials/chatbot

block scripts
  script().
    window.script = {
      chatbotEnabled: !{JSON.stringify(!!chatbotEnabled)}
    };
    window.openChat = function() {};
    const initialNumComments = !{JSON.stringify(user.numComments || 0)};
  script(src='/public/js/script.js')
  script(src='/public/js/postFunctionalities.js')
  if chatbotEnabled
    script(src='/public/js/chatbot.js')

  script().
    $(document).ready(function() {
      $('#loading').addClass('hidden');
      $('#content').removeClass('hidden');

      if (window.script.chatbotEnabled) {
        setTimeout(function() {
          const firstPost = $('.ui.fluid.card[type="actor"]').first();
          if (firstPost.length) {
            openChat({ target: firstPost[0] });
          }
        }, 1000);
      }
    });

    $(document).on('click', '#proceed-btn', async function() {
      try {
        const response = await fetch('/api/training-status');
        const data = await response.json();
        const currentNumComments = data.numComments;
        const userTurns = data.userTurns;
        const hasPostedComment = currentNumComments > initialNumComments;
        const canProceed = window.script.chatbotEnabled
          ? (userTurns >= 5 || hasPostedComment)
          : hasPostedComment;

        if (canProceed) {
          window.location.href = '/';
        } else {
          $('#error-msg').transition('slide down');
          setTimeout(function() {
            $('#error-msg').transition('slide up');
          }, 5000);
        }
      } catch (err) {
        console.error('Error fetching training status:', err);
        $('#error-msg').transition('slide down');
        setTimeout(function() {
          $('#error-msg').transition('slide up');
        }, 5000);
      }
    });
