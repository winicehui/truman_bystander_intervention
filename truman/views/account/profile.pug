extends ../ui_layout

block styles
  link(type='text/css', rel='stylesheet', href='/public/css/signup.css')

block content
  .sixteen.wide.column(style="margin-top: 2em; margin-bottom: 2em;")
    .ui.card.fluid 
      h2(style="text-align: center;") Update My Profile

      form.ui.large.form(action='/account/profile', method='POST', enctype='multipart/form-data', id='profile')
        input(type='hidden', name='_csrf', value=_csrf)
        input(type='hidden', name='profile_picture')
        .field
          label(for='name') Name
          input.form-control(type='text', name='name', id='name', value=user.profile.name)
        .field
          label(for='location') Location
          input.form-control(type='text', name='location', id='location', value=user.profile.location)
        .field
          label(for='bio') Bio
          textarea(rows='2', name='bio', id='bio')=user.profile.bio
        .field.image-upload
          label(style="font-weight: bold; font-size: medium; margin-bottom: 0.2em") Profile Picture 
            span(style="font-weight: normal") (Click to Change)
          .images
            each filename in profilePictures
              .image(tabindex='0', class=(user.profile.picture == `/profile_pictures/${filename}`) ? "selected" : "")
                a.avatar
                  img(src=`/profile_pictures/${filename}`)
        button.ui.large.button.disabled(type='submit') Update Profile

block scripts
  script(src='/public/js/profile.js')