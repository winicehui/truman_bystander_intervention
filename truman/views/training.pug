extends ui_layout

block styles
  link(type='text/css', rel='stylesheet', href='/public/css/com.css')

block content
  .sixteen.wide.column.centered#com
    .ui.card
      .com-header
        h1 Welcome to FreshView community training!
      .com-content
          p In this session, you will view a social media post and practice responding constructively.
          p When you are ready, press <strong>Start</strong> to begin.
      .com-footer
        .com-footer-content
          img.com-logo(src='/public/favicon.svg', alt='<strong style="color: black;">FreshView</strong> Logo')
          .com-enter
            a.ui.large.primary.button(href='/training_module') Start