.ui.fluid.actor.card(postCondition=val.condition, postID=val.id, type='actor', index=val.postID, actor_un = val.actor.username, actor_name = val.actor.profile.name, actor_pic = val.actor.profile.picture, class=val.flagged ? "flagged" : "")
  .ui.icon.button.continue-chat-button.hidden
    i.ui.large.comments.icon
  .content.post-header
    a(href='/user/'+val.actor.username)     
      img.ui.avatar.image.lazy(src='/public/picture.svg', data-src=cdn+"/profile_pictures/"+val.actor.profile.picture)
      span.username=val.actor.profile.name
    .time.meta= (user.createdAt.getTime() + val.time)
  .content
    if val.picture
      .img.post.image
        img.lazy(src='/public/picture.svg', data-src=cdn+"/post_pictures/"+val.picture, style="max-width:100%; width:100%;")
    .description(class=(val.class=="cyberbullying") ? "cyberbullying" : null)=val.body
  .ui.bottom.three.attached.icon.buttons
    .ui.reply.button(tabindex='0')
      i.reply.icon
      |  Reply
    .ui.flag.button(tabindex='0', class=val.flagged ? "orange" : null)
      i.flag.icon
      span.label=(val.flagged ? " Flagged" : " Flag")
    .ui.labeled.button(tabindex='0')
      .ui.like.button(class=val.liked? "red": null)
        i.heart.icon
        span.label=(val.liked ? " Liked" : " Like")
      a.ui.basic.red.left.pointing.label.count=val.likes
  if val.comments.length > 0
    .content
      .ui.comments
        each comment in val.comments
          .comment(commentID=comment.new_comment ? comment.commentID : comment.id, class=(comment.class || "") + (comment.flagged ? " flagged" : "") + (isTrainingModule && comment.class === "cyberbullying" ? " flagged" : ""), index=comment.commentID)
            if comment.new_comment
              a.avatar(href='/me')
                img(src=user.profile.picture)
            else 
              a.avatar(href='/user/'+comment.actor.username)                  
                img.lazy(src='/public/picture.svg', data-src=cdn+"/profile_pictures/"+comment.actor.profile.picture)
            .content
              if comment.new_comment
                a.author(href='/me') !{user.profile.name || user.username} (me)
              else 
                a.author(href='/user/'+comment.actor.username) !{comment.actor.username}
              .metadata
                span.date=(user.createdAt.getTime() + comment.time)
              .text=comment.body
              .actions
                a.reply Reply
                a.like(class=comment.liked ? "red" : null )
                  i.icon.heart(class=comment.liked ? "red" : null)
                  span.num=comment.likes+(comment.liked ? 1 : 0)
                if !comment.new_comment
                  a.flag(class=comment.flagged ? "orange" : null)
                    i.icon.flag(class=comment.flagged ? "orange" : null)
                    span.label=(comment.flagged ? " Flagged" : " Flag")
            if comment.subcomments.length!==0
              .comments.subcomments
                each subcomment in comment.subcomments
                  .comment(commentID=subcomment.new_comment ? subcomment.commentID : subcomment.id, index=subcomment.commentID, class=(subcomment.class || "") + (subcomment.flagged ? " flagged" : ""))
                    if subcomment.new_comment 
                      a.avatar.image(href='/me')
                        img(src=user.profile.picture)
                    else
                      a.avatar
                        img.lazy(src='/public/picture.svg', data-src=cdn+'/profile_pictures/'+subcomment.actor.profile.picture)
                    .content
                        if subcomment.new_comment
                          a.author(href='/me') !{user.username} (me)
                        else 
                          a.author(href='/user/'+subcomment.actor.username) !{subcomment.actor.username}
                        .metadata
                          span.date !{user.createdAt.getTime() + subcomment.time}
                        .text !{subcomment.body}
                        .actions
                          a.reply Reply
                          a.like(class=subcomment.liked ? "red" : null)
                            i.icon.heart(class=subcomment.liked ? "red" : null)
                            span.num=subcomment.likes+(subcomment.liked ? 1 : 0)
                          if !subcomment.new_comment 
                            a.flag(class=subcomment.flagged ? "orange" : null)  
                              i.icon.flag(class=subcomment.flagged ? "orange" : null)
                              span.label=(subcomment.flagged ? " Flagged" : " Flag")
  .extra.content
    .ui.form
      .inline.field
        if user && user.profile && user.profile.picture
          img.ui.image.rounded(src=user.profile.picture)
        else
          img.ui.image.rounded(src=user.gravatar(60))
        textarea.replyToPost(name='replyToPost' type='text' placeholder='Add a Comment...' rows='1' data-autoresize)
        i.big.send.link.icon.replyToPost
  if isTrainingModule
    .extra.content
      .ui.hidden.small.message#error-msg
        p You need to interact with the Community Assistant chatbot for at least <strong>7 message turns</strong> before proceeding.
      .ui.right.aligned
        div(style="display:flex; align-items:center; justify-content:flex-end; gap:12px;")
          h3.ui.inline.header(style="margin:0") Done with Training? 👉
          .ui.large.primary.button#proceed-btn Proceed
