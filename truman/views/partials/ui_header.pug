- const trainingConditions = ['C1']
.computer.only.tablet.only.row 
  .ui.borderless.fixed.menu
    .ui.container
      a.item(href=(!user ? `/?ResponseID=${ResponseID || r_id || ''}&Condition=${Condition || ''}` : (!user.consent ? "/com" : (!trainingConditions.includes(user.experimentalCondition) || user.finishedTraining ? "/" : "/training_intro"))))
        img.ui.tiny.image(src=process.env.SITE_LOGO, id='logo')
      .right.menu
        if !user
          //- a.item(href=process.env.POST_SURVEY_WITH_QUALTRICS ? `/login?ResponseID=${ResponseID || r_id || ''}&Condition=${Condition || ''}`: '/login') Log In
          a.item(href=process.env.POST_SURVEY_WITH_QUALTRICS ? `/signup?ResponseID=${ResponseID || r_id || ''}&Condition=${Condition || ''}`: '/signup') Create Account
        else
          if user.consent && (!trainingConditions.includes(user.experimentalCondition) || user.finishedTraining) && !isTrainingModule
            a.item(href='/community-guidelines') Community Guidelines
            a.item(href='/notifications') 
              i.big.alarm.icon
          .ui.simple.dropdown.item
            img.ui.mini.spaced.circular.image(src=user.profile.picture)
            span(style="margin-right: 5px;")= user.profile.name || user.username || user.id
            i.dropdown.icon
            .left.menu
              if user.consent && (!trainingConditions.includes(user.experimentalCondition) || user.finishedTraining) 
                a.item(href='/me') My Profile
                a.item(href='/account') Update My Profile
                if user.isAdmin
                  a.item(href='/completed') Study Progress
                  a.item(href='/actors') Simulation (Actors)
                //- a.item(href='/com?feed=true') View Community Guildelnes
.mobile.only.row
  .ui.fluid.top.fixed.item.menu(class = user ? "four" : "two")
    a.item(href=(!user ? `/?ResponseID=${ResponseID || r_id || ''}&Condition=${Condition || ''}` : (!user.consent ? "/com" : (!trainingConditions.includes(user.experimentalCondition) || user.finishedTraining ? "/" : "/training_intro"))))
      img.ui.tiny.image(src=process.env.SITE_LOGO, id='mobile_logo')
    if !user
      a.item(href=process.env.POST_SURVEY_WITH_QUALTRICS ? `/signup?ResponseID=${ResponseID || r_id || ''}&Condition=${Condition || ''}`: '/signup') Create Account
    else
      if user.consent && (!trainingConditions.includes(user.experimentalCondition) || user.finishedTraining) && !isTrainingModule
        a.item(href='/community-guidelines') Guidelines
        a.item(href='/notifications') 
          i.big.alarm.icon
      else 
        .item 
        .item
      .ui.simple.dropdown.item
        img.ui.mini.spaced.circular.image(src=user.profile.picture)
        i.dropdown.icon
        .left.menu
          if user.consent && (!trainingConditions.includes(user.experimentalCondition) || user.finishedTraining)
            a.item(href='/me') My Profile
