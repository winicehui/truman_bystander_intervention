//- Chat Box  
#chatbot-onboarding-overlay.hidden
#chatbot-onboarding-bubble.hidden
  .chatbot-onboarding-title Meet the Community Assistant!
  .chatbot-onboarding-body An AI assistant that detects potentially harmful content and helps you craft the right response. Send a message below to get started.
#copilot-chat.container.clearfix
  .chat.hidden
    .chat-header.clearfix
      i.large.close.icon.chat-close.float-right
      i.window.minimize.large.icon.chat-minimize.float-right
      i.ui.large.shield.alternate.icon.bot-header-icon
      .chat-about
        .chat-with 
          | Community Assistant
    .chat-history
      ul
    .chat-message.clearfix
      #chatbot-onboarding-dot.hidden
        span.chatbot-onboarding-dot-pulse
      .ui.form
        .inline.field
          textarea#message-to-send(type='text', name='message-to-send', placeholder='Type your message', rows=2)
          button.ui.primary.button(type='button')
            i.send.icon
            | Send
#copilot-chat-toggle.hidden
  i.ui.large.shield.alternate.icon
  span Community Assistant 

script#my-message-template(type='text/x-handlebars-template').
  <li class="clearfix">
    <div class="ui grid centered">
      <div class="thirteen wide right aligned column padding-right-small my-message-div">
          <div class="my-message align-right">
            {{#if isTypingAnimation}}
                <img src="/typing.gif"/>
            {{else}}
              {{{messageOutput}}}
            {{/if}}
          </div>
          <span class="message-data-time align-right">{{time}}</span>
        </div>
        {{#if addProfilePhoto}}
        <div class="three wide column padding-left-small avatar-col">
          <div class="align-center">
                <img class="message-avatar user-avatar" src="{{avatar}}" />
          </div>
        </div>
        {{/if}}
      </div>
    </div>
  </li>
script#other-message-template(type='text/x-handlebars-template').
  <li class="clearfix">
    <div class="ui grid centered">
        {{#if addProfilePhoto}}
        <div class="three wide column padding-right-small avatar-col">
          <div class="align-center">
            {{#if isAgent}}
                <i class='ui large shield alternate icon bot-avatar'></i>
            {{else}}
                <img class="message-avatar bot-avatar" src="{{avatar}}" />
            {{/if}}
          </div>
        </div>
        {{/if}}
        <div class="thirteen wide right aligned column padding-left-small other-message-div">
          <div class="other-message align-left">
            {{#if isTypingAnimation}}
                <img src="/public/typing.gif"/>
            {{else}}
              {{{messageOutput}}}
            {{/if}}
          </div>
          <span class="message-data-time align-left">{{time}}</span>
        </div>
      </div>
    </div>
  </li>
